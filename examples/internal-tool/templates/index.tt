[% WRAPPER layout.tt title = 'Task board' %]
<h1>Task board</h1>

[% IF flash %]<p class="flash">[% flash | html %]</p>[% END %]

<form method="post" action="[% url('create') | html %]" class="add">
  <input type="hidden" name="csrf_token" value="[% csrf_token | html %]">
  <label>Title
    <input name="title" value="[% form.title | html %]" autofocus>
    [% IF errors.title %]<span class="error">[% errors.title | html %]</span>[% END %]
  </label>
  <label>Due
    <input name="due" value="[% form.due | html %]" placeholder="YYYY-MM-DD">
    [% IF errors.due %]<span class="error">[% errors.due | html %]</span>[% END %]
  </label>
  <button type="submit">Add task</button>
</form>

<ul class="tasks">
[% FOREACH task IN tasks %]
  <li class="[% task.done ? 'done' : 'open' %]">
    <span class="title">[% task.title | html %]</span>
    [% IF task.due %]<span class="due">[% task.due | html %]</span>[% END %]
    <form method="post" action="[% url('toggle', { id = task.id }) | html %]">
      <input type="hidden" name="csrf_token" value="[% csrf_token | html %]">
      <button type="submit">[% task.done ? 'Reopen' : 'Done' %]</button>
    </form>
    <form method="post" action="[% url('delete', { id = task.id }) | html %]">
      <input type="hidden" name="csrf_token" value="[% csrf_token | html %]">
      <button type="submit">Delete</button>
    </form>
  </li>
[% END %]
</ul>
[% IF tasks.size == 0 %]<p class="empty">Nothing to do.</p>[% END %]
[% END %]
